# 필수: Postgres 연결 문자열 (Supabase/Neon 등 무료 인스턴스 권장).
# 로컬 컴퓨터 파일이 아니라 외부 DB를 쓰는 이유: 배포 서버(Render)의 로컬
# 디스크는 재배포될 때마다 초기화되기 때문에, 재배포와 무관하게 유지되는
# 곳에 데이터를 저장해야 합니다.
DATABASE_URL=

# 둘 중 하나만 채우면 됩니다. ANTHROPIC_API_KEY가 있으면 Claude를 우선 사용합니다.
# 주의: Claude Pro / ChatGPT Plus "구독"과 API 키는 별개입니다. API는 각 콘솔에서
# 별도로 발급받고 사용량만큼 과금됩니다 (console.anthropic.com / platform.openai.com).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 선택: 기본 모델을 바꾸고 싶을 때만 채우세요.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini

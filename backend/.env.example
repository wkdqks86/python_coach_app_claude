# 둘 중 하나만 채우면 됩니다. ANTHROPIC_API_KEY가 있으면 Claude를 우선 사용합니다.
# 주의: Claude Pro / ChatGPT Plus "구독"과 API 키는 별개입니다. API는 각 콘솔에서
# 별도로 발급받고 사용량만큼 과금됩니다 (console.anthropic.com / platform.openai.com).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 선택: 기본 모델을 바꾸고 싶을 때만 채우세요.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini
